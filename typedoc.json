{
    "$schema": "https://typedoc.org/schema.json",
    "entryPoints": [
        "src/*.ts"
    ],
    "exclude": [
        "src/**/*.test.ts",
        "src/globals.d.ts"
    ],
    "tsconfig": "tsconfig.build.json",
    "out": "docs/api",
    "plugin": [
        "typedoc-plugin-markdown",
        "typedoc-vitepress-theme"
    ],
    "docsRoot": "./docs",
    "readme": "none",
    "excludePrivate": true,
    "excludeInternal": true,
    "excludeExternals": true,
    "hideGenerator": true,
    "entryFileName": "index",
    "useCodeBlocks": true,
    "parametersFormat": "table",
    "interfacePropertiesFormat": "table",
    "classPropertiesFormat": "table",
    "sidebar": {
        "autoConfiguration": true,
        "format": "vitepress",
        "pretty": true,
        "collapsed": true
    },
    "gitRevision": "v4",
    "sourceLinkTemplate": "https://github.com/pencil-js/pencil.js/blob/{gitRevision}/{path}#L{line}"
}
